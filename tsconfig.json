{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "alwaysStrict": true,
    "baseUrl": "./",
    "paths": {
      "*": ["*"]
    },
    "types": ["node"]        
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],  //<-- include scripts folder if needed
  "exclude": ["node_modules", "dist"]
}
